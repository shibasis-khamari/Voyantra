# Voyantra Backend Environment Configuration Template
PROJECT_NAME="Voyantra API"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Google Gemini API Key (Optional / Free Tier)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash"

# MongoDB Connection (Local or MongoDB Atlas Cloud)
MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="voyantra_db"

# Auth: REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="change-me"

# Comma-separated allowed browser origins (defaults to localhost dev ports)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Only True behind a trusted reverse proxy (rate limiting uses X-Forwarded-For)
TRUST_PROXY_HEADERS=False
