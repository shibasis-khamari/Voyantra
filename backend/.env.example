# Voyantra Backend Environment Configuration Template
PROJECT_NAME="Voyantra API"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Google Gemini API Key (Optional / Free Tier)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash"

# MongoDB Connection (Local or MongoDB Atlas Cloud)
MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="voyantra_db"
